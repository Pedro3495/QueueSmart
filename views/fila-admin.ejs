<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>QueueSmart - <%= fila.nome %></title>
  <link rel="stylesheet" href="/css/fila-admin.css" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>

  <a class="skip-link" href="#conteudo-principal">Pular para o conteúdo principal</a>

  <header class="topbar" role="banner">
    <a class="topbar-logo" href="/dashboard" aria-label="Voltar ao painel">QueueSmart</a>
    <nav class="topbar-nav" aria-label="Navegação do usuário">
      <a class="btn-voltar" href="/painel/<%= fila.id %>">Painel público</a>
      <a class="btn-voltar" href="/dashboard">← Painel</a>
    </nav>
  </header>

  <main id="conteudo-principal" class="main-content">

    <!-- Cabeçalho da fila -->
    <section class="secao-cabecalho" aria-labelledby="titulo-fila">
      <p class="eyebrow">Gerenciar fila</p>
      <h1 id="titulo-fila"><%= fila.nome %></h1>
      <% if (fila.descricao) { %>
        <p class="subtitulo"><%= fila.descricao %></p>
      <% } %>
    </section>

    <!-- Ação: chamar próximo -->
    <section class="secao-acao" aria-label="Ação de atendimento">
      <%
        const aguardando = clientes.filter(c => c.status === 'aguardando')
        const chamados   = clientes.filter(c => c.status === 'chamado')
      %>

      <div class="painel-contadores" role="status" aria-live="polite">
        <div class="contador">
          <span class="contador-numero"><%= aguardando.length %></span>
          <span class="contador-rotulo">aguardando</span>
        </div>
        <div class="contador">
          <span class="contador-numero"><%= chamados.length %></span>
          <span class="contador-rotulo">chamado(s)</span>
        </div>
      </div>

      <form action="/filas/<%= fila.id %>/chamar" method="POST">
        <button class="btn-chamar" type="submit"
          <% if (aguardando.length === 0) { %> disabled aria-disabled="true" <% } %>>
          Chamar próximo
        </button>
      </form>

      <% if (chamados.length > 0) { %>
        <div class="chamado-atual" role="status" aria-live="assertive">
          <span class="chamado-rotulo">Atendendo agora:</span>
          <strong class="chamado-nome"><%= chamados[chamados.length - 1].nome %></strong>
        </div>
      <% } %>
    </section>

    <!-- Lista de clientes -->
    <section class="secao-lista" aria-labelledby="titulo-lista">
      <h2 id="titulo-lista">Clientes na fila</h2>

      <% if (clientes.length === 0) { %>
        <p class="lista-vazia">Nenhum cliente na fila no momento.</p>

        <!-- Link para o cliente entrar na fila -->
        <div class="link-cliente-box">
          <p class="link-cliente-descricao">Painel público para TV ou recepção:</p>
          <a class="link-cliente" href="/painel/<%= fila.id %>">/painel/<%= fila.id %></a>
          <p class="link-cliente-descricao link-cliente-espaco">Compartilhe este link com seus clientes:</p>
          <a class="link-cliente" href="/cliente/<%= fila.id %>">/cliente/<%= fila.id %></a>
        </div>
      <% } else { %>
        <ul class="lista-clientes" role="list">
          <% clientes.forEach(function(cliente) { %>
            <li class="item-cliente item-<%= cliente.status %>">
              <span class="cliente-posicao" aria-label="Posição <%= cliente.posicao %>">#<%= cliente.posicao %></span>
              <span class="cliente-nome"><%= cliente.nome %></span>
              <span class="badge badge-<%= cliente.status %>"><%= cliente.status %></span>
            </li>
          <% }) %>
        </ul>

        <div class="link-cliente-box">
          <p class="link-cliente-descricao">Painel público para TV ou recepção:</p>
          <a class="link-cliente" href="/painel/<%= fila.id %>">/painel/<%= fila.id %></a>
          <p class="link-cliente-descricao link-cliente-espaco">Link para novos clientes:</p>
          <a class="link-cliente" href="/cliente/<%= fila.id %>">/cliente/<%= fila.id %></a>
        </div>
      <% } %>
    </section>

  </main>

  <footer class="rodape" role="contentinfo">
    <a class="link-footer" href="/acessibilidade">Acessibilidade</a>
  </footer>

</body>
</html>
